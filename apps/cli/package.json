{
  "name": "@contextops/cli",
  "version": "0.1.0",
  "description": "ContextOps local-first AI coding workflow intelligence CLI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "contextops": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/ensure-bin.mjs dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@contextops/adapters": "workspace:*",
    "@contextops/analyzer": "workspace:*",
    "@contextops/config": "workspace:*",
    "@contextops/core": "workspace:*",
    "@contextops/pricing": "workspace:*",
    "@contextops/replay": "workspace:*",
    "@contextops/storage": "workspace:*",
    "commander": "^12.1.0"
  }
}
