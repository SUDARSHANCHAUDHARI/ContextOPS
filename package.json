{
  "name": "contextops",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first workflow intelligence for AI coding tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm clean && turbo run build --force",
    "cli": "tsx apps/cli/src/index.ts",
    "clean": "node scripts/clean.mjs",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:check": "node scripts/package-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm package:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm release:check && pnpm pack:check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@next/env": "^15.5.28",
    "@types/react": "^19.2.17",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ink": "^5.2.1",
    "next": "^15.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^2.15.4",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "brace-expansion@<1.1.20": "^1.1.20",
      "browserslist@<4.28.7": "^4.28.7",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.18",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
